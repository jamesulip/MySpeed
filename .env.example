# MySpeed Environment Template
# Copy this file to .env and configure according to your needs

# Database Configuration
# ======================

# Database Type: Choose 'sqlite' or 'mysql'
DB_TYPE=sqlite

# SQLite Configuration (Default)
# ------------------------------
# SQLite is the default database and requires no additional setup.
# The database file will be automatically created at: data/storage.db
# For preview mode, it will use: data/storage_preview.db

# MySQL Configuration
# -------------------
# To use MySQL, set DB_TYPE=mysql and configure the following:

# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=myspeed
# DB_USER=myspeed_user
# DB_PASS=your_secure_password

# Example MySQL Setup Commands:
# CREATE DATABASE myspeed;
# CREATE USER 'myspeed_user'@'localhost' IDENTIFIED BY 'your_secure_password';
# GRANT ALL PRIVILEGES ON myspeed.* TO 'myspeed_user'@'localhost';
# FLUSH PRIVILEGES;

# Server Configuration
# ====================
SERVER_PORT=5216

# Preview Mode Configuration
# ==========================
# Enable preview mode for testing/demo purposes
PREVIEW_MODE=false
PREVIEW_MESSAGE=This is a preview instance

# Development Configuration
# =========================
# NODE_ENV=development
# DEBUG=true

# Example Production Configuration
# ================================
# NODE_ENV=production
# DB_TYPE=mysql
# DB_HOST=your-mysql-host
# DB_NAME=myspeed_production
# DB_USER=myspeed_prod_user
# DB_PASS=your_very_secure_password
# SERVER_PORT=5216
